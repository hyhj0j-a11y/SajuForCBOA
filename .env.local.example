# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — never commit it, and never read these values from client code.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite when unset.
# Picked for free-tier quota, not for being newest: the preview Flash models allow only 20
# requests per DAY on the free tier, which one presentation would blow through. Check the quota,
# not just the model list, before switching a live event to another model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Most Gemini calls allowed in flight at once. Defaults to 10.
MAX_CONCURRENT=10
