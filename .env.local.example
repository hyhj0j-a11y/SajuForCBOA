# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — never commit it, and never read these values from client code.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash
